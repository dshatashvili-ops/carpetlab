# Домен сайта (Caddy сам выпустит HTTPS-сертификат). Хостинг и БД размещаются на серверах в РФ (152-ФЗ).
SITE_ADDRESS=carpetlab.example.ru
APP_URL=https://carpetlab.example.ru

POSTGRES_PASSWORD=change-me-admin
APP_DB_PASSWORD=change-me-app

# Почта (приглашения сотрудников и подтверждение e-mail не работают без SMTP)
SMTP_URL=smtps://user:password@smtp.example.ru:465
MAIL_FROM=CarpetLAB <no-reply@carpetlab.example.ru>

# ЮKassa (карты и СБП)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
